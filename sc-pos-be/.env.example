# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=sc-pos
DB_SSLMODE=disable

# JWT Configuration
JWT_SECRET_KEY=secret
JWT_EXPIRY_HOURS=24
JWT_REFRESH_EXPIRY_HOURS=168

# Public landing page fallback organization. When no slug is present in the URL,
# the backend uses this organization slug. Leave empty to use the first active org.
DEFAULT_PUBLIC_ORG_SLUG=shasi-beauty-care

# URL publik untuk generate URL upload (local storage only)
BASE_URL=http://localhost:8080
UPLOAD_DIR=uploads

# ─── Storage Configuration ───────────────────────────────────────────
# STORAGE_PROVIDER: "local" (default) or "supabase"
#   local    → files saved to UPLOAD_DIR, served via BASE_URL
#   supabase → files uploaded to Supabase S3-compatible bucket
STORAGE_PROVIDER=local

# S3 settings (only used when STORAGE_PROVIDER=supabase)
# Endpoint format: https://<project-ref>.storage.supabase.co/storage/v1/s3
# Create S3 credentials in Supabase Dashboard → Settings → S3 Protocol
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=ap-southeast-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true

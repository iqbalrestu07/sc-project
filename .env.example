# ─── Database (Supabase) ─────────────────────────────────────────────────────
# Host, port, dan nama DB Supabase Anda. Password TANPA tanda kutip di sini
# karena docker-compose tidak melakukan variable expansion seperti godotenv.
# Jika password mengandung karakter khusus ($, !, dll), gunakan tanda kutip
# tunggal di file .env:  DB_PASSWORD='$62@aX6Q!A%4Kz?'
DB_HOST=db.xtgitbuwmrsdwdmmbmdl.supabase.co
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=ganti_password_ini
DB_NAME=postgres
DB_SSLMODE=disable

# ─── Backend ──────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=ganti-dengan-string-acak-panjang-minimal-32-karakter
JWT_EXPIRY_HOURS=24
JWT_REFRESH_EXPIRY_HOURS=168

# URL publik backend — dipakai untuk generate URL upload (gambar, dll).
# Gunakan domain publik (tanpa /api) untuk deployment Cloudflare Tunnel.
# Contoh publik : https://shasi-beauty.com
BACKEND_BASE_URL=https://shasi-beauty.com

# Port backend yang di-expose ke host. Default 8080.
BACKEND_PORT_EXPOSE=8080

# Organisasi yang digunakan landing page pada root domain (/).
# Landing tenant spesifik tersedia pada /<organization-slug>.
DEFAULT_PUBLIC_ORG_SLUG=

# WhatsApp (opsional — kosongkan jika tidak dipakai)
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# ─── Storage ──────────────────────────────────────────────────────────────────
# STORAGE_PROVIDER: "local" (default) atau "supabase"
#   local    → files saved to UPLOAD_DIR volume, served via BACKEND_BASE_URL
#   supabase → files uploaded to Supabase S3-compatible bucket
STORAGE_PROVIDER=supabase

# S3 settings (only used when STORAGE_PROVIDER=supabase)
# Endpoint format: https://<project-ref>.storage.supabase.co/storage/v1/s3
# Create S3 credentials in Supabase Dashboard → Settings → S3 Protocol
S3_BUCKET=shasi-bucket
S3_ENDPOINT=https://xtgitbuwmrsdwdmmbmdl.storage.supabase.co/storage/v1/s3
S3_REGION=ap-southeast-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true

# ─── Frontend ─────────────────────────────────────────────────────────────────
# URL API yang DIGUNAKAN BROWSER untuk hit backend.
# Untuk single-domain deployment: /api (relatif, diproxy oleh nginx frontend)
# Untuk multi-domain deployment: https://api.namadomain.com/api
#
# PENTING: Setelah mengubah nilai ini, jalankan ulang:
#   docker compose up --build frontend
VITE_API_BASE_URL=/api

# Port frontend yang di-expose ke host. Default 3000.
FRONTEND_PORT_EXPOSE=3000

# ─── Cloudflare Tunnel ────────────────────────────────────────────────────────
# Token tunnel dari dashboard Cloudflare.
# Cara mendapatkannya:
#   1. https://one.dash.cloudflare.com → Networks → Tunnels → Create a tunnel
#   2. Pilih "Cloudflared", beri nama (misal: sc-klinik), klik Next
#   3. Copy token yang ditampilkan di halaman instalasi
#   4. Paste di sini
#
# Setelah itu, di halaman tunnel yang sama → tab "Public Hostname" → Add:
#   Hostname: shasi-beauty.com | Service: HTTP | URL: frontend:80
#   Backend diakses via /api dan /uploads melalui nginx reverse proxy.
#
# Jika tidak memakai Cloudflare Tunnel, hapus/komentari service "cloudflared"
# di docker-compose.yml dan biarkan variabel ini kosong.
CLOUDFLARE_TUNNEL_TOKEN=
